# DEADRECKON :: environment
# cp .env.example .env

# ---------------------------------------------------------------- required
# Render provides this automatically via the Blueprint. Locally, point it at
# any Postgres 14+. Neon and Supabase both work and both have free tiers that
# do not expire after 30 days the way Render's does.
DATABASE_URL=postgres://deadreckon:deadreckon@localhost:5432/deadreckon

# ------------------------------------------------------- feed credentials
# All optional. Every source degrades independently: a missing key disables
# one domain and nothing else.

# aisstream.io -- free, instant. WITHOUT THIS THE SEA DOMAIN IS OFF, and
# DARK_VESSEL / SPOOF_DISCONTINUITY / RENDEZVOUS cannot fire. Get this one.
AISSTREAM_API_KEY=

# NASA FIRMS -- free key, VIIRS/MODIS active fire.
# https://firms.modaps.eosdis.nasa.gov/api/
FIRMS_MAP_KEY=

# OpenSky OAuth2 -- optional, raises the ADS-B rate limit and adds global
# coverage in one call. Without it we use adsb.lol, which needs no key.
# NOTE: OpenSky is CC BY-SA 4.0 and non-commercial without a separate
# agreement. See docs/OWNERSHIP.md before using it in anything commercial.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# ----------------------------------------------------------------- server
PORT=8080
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

# Fan-out tick. Lower is smoother and costs one shared query per tick,
# not one per viewer.
FANOUT_TICK_MS=1000
# Hard cap on how many geohash cells one socket may subscribe to. A client
# does not get to choose how much it costs us.
MAX_CELLS_PER_SOCKET=512

# ----------------------------------------------------------------- ingest
POLL_AIR_S=20
POLL_GEO_S=60
POLL_THERMAL_S=900
POLL_ORBIT_S=21600
ENGINE_TICK_S=30

# Tiered retention, hours. Full fidelity for RETAIN_RAW_H, then thinned to
# one fix per entity per 5 min out to RETAIN_TRACK_H.
RETAIN_RAW_H=12
RETAIN_TRACK_H=168

# ------------------------------------------------------------------- web
# Build-time only. Must be set on the static site before it is built.
VITE_API_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080/stream
